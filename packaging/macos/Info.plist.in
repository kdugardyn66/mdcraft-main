<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- packaging/macos/package.sh substitutes @VERSION@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>MdCraft</string>
  <key>CFBundleName</key><string>MdCraft</string>
  <key>CFBundleExecutable</key><string>mdcraft</string>
  <key>CFBundleIdentifier</key><string>io.github.kdugardyn.mdcraft</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundleIconFile</key><string>mdcraft</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSRequiresAquaSystemAppearance</key><false/>
  <key>NSHumanReadableCopyright</key><string>© Kris Dugardyn and the mdcraft contributors. MIT OR Apache-2.0.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Markdown document</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>net.daringfireball.markdown</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>MdCraft document template</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeIconFile</key><string>mdcraft</string>
      <key>LSItemContentTypes</key><array><string>io.github.kdugardyn.mdcraft.document-template</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>MdCraft slide template</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeIconFile</key><string>mdcraft</string>
      <key>LSItemContentTypes</key><array><string>io.github.kdugardyn.mdcraft.slide-template</string></array>
    </dict>
  </array>
  <!-- MdCraft's own template files: Markdown text, .mdd (document) and .mds (slides). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.kdugardyn.mdcraft.document-template</string>
      <key>UTTypeDescription</key><string>MdCraft document template</string>
      <key>UTTypeConformsTo</key><array><string>net.daringfireball.markdown</string><string>public.plain-text</string></array>
      <key>UTTypeIconFile</key><string>mdcraft</string>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>mdd</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.kdugardyn.mdcraft.slide-template</string>
      <key>UTTypeDescription</key><string>MdCraft slide template</string>
      <key>UTTypeConformsTo</key><array><string>net.daringfireball.markdown</string><string>public.plain-text</string></array>
      <key>UTTypeIconFile</key><string>mdcraft</string>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>mds</string></array></dict>
    </dict>
  </array>
  <!-- Older macOS versions don't know the Markdown type; without this, Finder can't match
       .md files to the document type above (LSItemContentTypes wins over extensions). -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key><string>Markdown document</string>
      <key>UTTypeConformsTo</key><array><string>public.plain-text</string></array>
      <key>UTTypeReferenceURL</key><string>https://daringfireball.net/projects/markdown/</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>md</string><string>markdown</string><string>mdown</string><string>mkd</string></array>
        <key>public.mime-type</key><array><string>text/markdown</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
